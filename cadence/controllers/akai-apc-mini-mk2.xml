  <bind target="ch1.sync" kind="1" ch="1" num="104" label="Track Button 5" status="manual"/>  <!-- Track Button 5, p.15 -->
  <bind target="ch2.sync" kind="1" ch="1" num="105" label="Track Button 6" status="manual"/>  <!-- Track Button 6, p.15 -->
