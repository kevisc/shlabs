  <bind target="ch1.filter" kind="0" ch="1" num="52" label="Channel Fader 5" status="manual"/>  <!-- Channel Fader 5, p.16 -->
  <bind target="ch2.filter" kind="0" ch="1" num="53" label="Channel Fader 6" status="manual"/>  <!-- Channel Fader 6, p.16 -->
  <bind target="ch3.filter" kind="0" ch="1" num="54" label="Channel Fader 7" status="manual"/>  <!-- Channel Fader 7, p.16 -->
  <bind target="ch4.filter" kind="0" ch="1" num="55" label="Channel Fader 8" status="manual"/>  <!-- Channel Fader 8, p.16 -->
  <bind target="master.gain" kind="0" ch="1" num="56" label="Master Fader (fader 9)" status="manual"/>  <!-- Master Fader (fader 9), p.16 -->
  <bind target="ch1.cue" kind="1" ch="1" num="100" label="Track Button 1" status="manual"/>  <!-- Track Button 1, p.15 -->
