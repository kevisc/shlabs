  <bind target="ch1.mid" kind="0" ch="1" num="11" status="manual"/>  <!-- CH1 EQ MID knob, p. 2 -->
  <bind target="ch1.low" kind="0" ch="1" num="15" status="manual"/>  <!-- CH1 EQ LOW knob, p. 2 -->
  <bind target="ch1.cue" kind="1" ch="1" num="84" status="manual"/>  <!-- CH1 CH CUE (headphone cue) button, p. 2 -->
  <bind target="ch1.filter" kind="0" ch="7" num="23" status="manual"/>  <!-- CH1 FILTER knob, p. 2 -->
  <bind target="ch1.cuepad2" kind="1" ch="8" num="1" status="manual"/>  <!-- Deck 1 PAD 2, HOT CUE mode, p. 2 -->
