  <bind target="ch2.jog" kind="0" ch="2" num="34" mode="rel" rel="binoff" status="manual"/>  <!-- Deck 2 jog dial, platter (top) turn, Vinyl mode on, p. 1 -->
  <bind target="ch2.sync" kind="1" ch="2" num="88" status="manual"/>  <!-- Deck 2 BEAT SYNC, p. 1 -->
