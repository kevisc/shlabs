  <bind target="ch1.loophalf" kind="1" ch="1" num="81" status="manual"/>  <!-- Deck 1 CUE/LOOP CALL ◀ (halves the loop during loop playback), p. 1 -->
  <bind target="ch1.loopdbl" kind="1" ch="1" num="83" status="manual"/>  <!-- Deck 1 CUE/LOOP CALL ▶ (doubles the loop during loop playback), p. 1 -->
  <bind target="ch1.load" kind="1" ch="7" num="70" status="manual"/>  <!-- LOAD button, deck 1, p. 1 -->
  <bind target="ch1.gain" kind="0" ch="1" num="19" status="manual"/>  <!-- CH1 channel fader, p. 2 -->
